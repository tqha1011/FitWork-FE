{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://fitworkbe-nestjs.onrender.com/api/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://fitworkbe-nestjs.onrender.com/socket.io/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
