# Copy this file to .env (or .env.local) and fill in real values.
#
# All env vars consumed by the client MUST be prefixed with VITE_ and are
# read via import.meta.env.VITE_*.
#
# IMPORTANT: Vite bakes these values into the JS bundle at BUILD time, not
# at container/runtime start. If you deploy the Docker image built here to
# multiple environments, you must rebuild the image (or re-run `vite build`)
# per environment/value — passing a different value to `docker run` at
# runtime has no effect on an already-built bundle.

# Choose one backend URL (keep only one line uncommented).
# Local backend:
VITE_API_BASE_URL=http://localhost:3000/api
# Render backend:
# VITE_API_BASE_URL=https://fitworkbe-nestjs.onrender.com/api

# Socket.IO origin (no namespace, no /api). Connects to <origin>/resume and
# <origin>/evaluation directly, so the backend must allow this frontend's
# origin via CORS. If unset, the origin of VITE_API_BASE_URL is used.
# Local backend:
VITE_SOCKET_URL=http://localhost:3000
# Render backend:
# VITE_SOCKET_URL=https://fitworkbe-nestjs.onrender.com
